# 数据库与缓存
DATABASE_URL=postgresql+asyncpg://gameforge:gameforge@localhost:5432/gameforge
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://gameforge:gameforge@localhost:5672/
# rabbitmq | memory（pytest 用 memory）
MESSAGING_BACKEND=rabbitmq

# 加密与签名（生产必改，禁硬编码）
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=900
REFRESH_TTL=2592000
LLM_APIKEY_ENCRYPTION_KEY=

# 邮件（dev 留空则控制台打印验证/重置链接，不发真实邮件）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 验证邮件里的验证页前缀（6 位验证码在此页输入，非链接 token）
FRONTEND_BASE_URL=http://127.0.0.1:5173
# 邮箱验证码有效期（秒），默认 600 = 10 分钟
# VERIFY_EMAIL_TTL=600

# 产物托管（本地目录；勿留空）
HOSTING_ROOT=.hosting
S3_ENDPOINT=
S3_BUCKET=
S3_AK=
S3_SK=

# 沙箱：local（联调）| docker（生产隔离）
SANDBOX_BACKEND=local
SANDBOX_IMAGE=gameforge/sandbox
SANDBOX_DEFAULT_TIER=standard

# 限流与配额
DEFAULT_DAILY_TOKEN_LIMIT=500000
DEFAULT_RATE_LIMIT_PER_MIN=30
MAX_CONCURRENT_RUNS=3
MAX_VERSIONS_PER_GAME=20
MAX_DRAFTS_PER_USER=20
MAX_PUBLISHED_PER_USER=50
SYSTEM_DAILY_TOKEN_ALERT=5000000

# langfuse（可选，trace 上报）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 全局
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
