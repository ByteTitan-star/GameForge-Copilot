# 数据库与缓存
DATABASE_URL=postgresql+asyncpg://gameforge:gameforge@localhost:5432/gameforge
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://gameforge:gameforge@localhost:5672/
# rabbitmq | memory（pytest 用 memory）
MESSAGING_BACKEND=rabbitmq

# 加密与签名（生产必改，禁硬编码）
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=7200
REFRESH_TTL=2592000
LLM_APIKEY_ENCRYPTION_KEY=

# 邮件（dev 留空则控制台打印验证码，不发真实邮件）
# 163 示例：SMTP_HOST=smtp.163.com SMTP_PORT=465 SMTP_USER=you@163.com
# SMTP_PASS=客户端授权码（非登录密码） SMTP_FROM=you@163.com
# SMTP_FROM_NAME=GameForge  （收件箱显示名，163 下地址须与 SMTP_USER 一致）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=GameForge
# 验证邮件里的验证页前缀（6 位验证码在此页输入，非链接 token）
FRONTEND_BASE_URL=http://127.0.0.1:5173
# 邮箱验证码有效期（秒），默认 600 = 10 分钟
# VERIFY_EMAIL_TTL=600

# 产物托管（本地目录；勿留空）
HOSTING_ROOT=.hosting
# local（默认）| s3 — s3 需配置下方凭证
HOSTING_BACKEND=local
# OAuth 回调与对外 API 根（OAuth redirect_uri 依赖此项）
API_PUBLIC_URL=http://127.0.0.1:8000
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_AK=
S3_SK=
S3_PREFIX=gameforge
# path（OSS 推荐）| virtual
S3_ADDRESSING_STYLE=path
S3_CONNECT_TIMEOUT=10
S3_READ_TIMEOUT=60

# 沙箱：默认 daytona（config）；无 DAYTONA_API_KEY 时进程内回退 docker→local
# SANDBOX_BACKEND=daytona
SANDBOX_IMAGE=gameforge/sandbox
SANDBOX_DEFAULT_TIER=standard
# SANDBOX_TIER_AUTO=true
# SANDBOX_DAYTONA_ENABLED=true
# 必填才能真正打到 Daytona 云（勿提交真实 key）
DAYTONA_API_KEY=
# DAYTONA_TIMEOUT_S=300

# 构建链（docs/build-pipeline.md；默认关，灰度时改为 true）
BUILD_PIPELINE_ENABLED=false
# docker（推荐，需 gameforge-builder:v1 镜像）| local（本机 pnpm 11+）
BUILDER_BACKEND=docker
BUILDER_IMAGE=gameforge-builder:v1
PNPM_STORE_PATH=.pnpm-store
NPM_REGISTRY=https://registry.npmmirror.com
BUILD_MAX_RETRIES=3
BUILDER_TIMEOUT_S=300
# 构建前镜像：docker compose --profile build-sandbox build builder

# 限流与配额
DEFAULT_DAILY_TOKEN_LIMIT=500000
DEFAULT_RATE_LIMIT_PER_MIN=30
MAX_CONCURRENT_RUNS=3
# HIL/暂停等待超时（秒）：默认 48h，超时后自动 FAILED 释放并发额度
HIL_WAIT_TIMEOUT_S=172800
# RUNNING 且无执行租约、超时无更新 → FAILED（秒）；有租约心跳的正常跑不会触发
RUNNING_STALE_TIMEOUT_S=7200
# LLM 熔断（按 user+provider）：连续失败达阈值后短时拒绝
LLM_CIRCUIT_ENABLED=true
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_OPEN_S=60
# worker 进程内同时处理的任务数（RabbitMQ prefetch_count）；慢 LLM 不再阻塞消费。
# 扩容再多开 worker 进程：docker compose up -d --scale worker=N（或设 WORKER_REPLICAS）
MAX_CONCURRENT_TASKS=3
# 消费侧毒消息重试上限；超过后写入 gameforge.worker.dlq，避免无限 requeue
WORKER_MAX_REDELIVERIES=5
MAX_VERSIONS_PER_GAME=20
MAX_DRAFTS_PER_USER=20
MAX_PUBLISHED_PER_USER=50
SYSTEM_DAILY_TOKEN_ALERT=5000000
# 美术方向/详细设计稿的 LLM 尝试次数，耗尽后自动使用内置素材库
ART_MAX_RETRIES=2
# 美术 A/B 是否并行各调一次模型（更快、约 2 倍 token）；false=单次返回两套
FORGE_ART_OPTIONS_PARALLEL=true
# 试玩前按策划稿静态验收（引擎/输入/HUD）；false=仅结构门禁+浏览器冒烟
FORGE_ACCEPTANCE_GATE=true
# 试玩会话内按 acceptance_criteria 探针（开始态/暂停/终态源码引用）
FORGE_ACCEPTANCE_RUNTIME=true
# CodeQaLoop 总 attempt（含首次 generate）；默认 3
CODE_QA_MAX_ATTEMPTS=3
# 单次 Forge Run 累计 LLM tokens（input+output）上限；0=关闭
FORGE_RUN_MAX_TOKENS=500000
# QA 通过后是否截取游戏卡片封面（需 Worker 已装 Chromium）
THUMBNAIL_ENABLED=true

# langfuse（可选，trace 上报）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# LLM HTTP 调用调优（complete()）
# 读超时（秒）：推理模型生整段代码可达数分钟，默认 600；超时则报 httpx.ReadTimeout
LLM_REQUEST_TIMEOUT=600
# 建连/写/连接池超时（秒），默认 30；服务端不可达时快速失败
LLM_CONNECT_TIMEOUT=30
# 传输层有限重试：网络抖动 / 429 / 502-504（与业务自修复预算正交）
LLM_HTTP_MAX_RETRIES=3
LLM_HTTP_RETRY_BASE_DELAY_S=0.5
# 默认 max_tokens（plan/art/qa）；GLM 冗长 JSON 易截断，默认 24576；code 另见 LLM_CODE_MAX_TOKENS
LLM_MAX_TOKENS=24576
# Code 阶段单独上限（整段 HTML / project JSON）
LLM_CODE_MAX_TOKENS=32768
# 输出截断后最多续写轮数
LLM_CONTINUATION_MAX_ROUNDS=3
# 续写 prompt 携带的已生成内容尾部字符数
LLM_CONTINUATION_TAIL_CHARS=8000
# 命中以下 host（逗号分隔的子串）则强制直连、绕过桌面/系统代理。Windows 上 httpx 会读
# 注册表代理（即便无 *_PROXY 环境变量），国内 provider 走它常因无出口而超时；默认列国内厂商。
# 海外/未知 host 仍沿用系统代理，保留「用代理访问 OpenAI 等」的能力。
LLM_DIRECT_HOSTS=dashscope.aliyuncs.com,api.deepseek.com,api.moonshot.cn,open.bigmodel.cn,api.siliconflow.cn,api.minimaxi.com,api.baichuan-ai.com,api.lingyiwanwu.com
# 默认关 thinking：Qwen→enable_thinking=false；智谱 GLM openai_compat→thinking.disabled
# （glm-5.3→reasoning_effort=low）；Anthropic 原生→thinking.disabled。需深度推理置 false。
LLM_DISABLE_THINKING=true

# 流式打字机输出：LLM 流式吐 token → 微批 LLM_DELTA 事件给前端。
# STREAM_ENABLED=false 则退化为非流式（流式体验与输出审核都停）。
STREAM_ENABLED=true
# 微批字符数 / 时间窗(ms)：攒够字符或超时即发一个 LLM_DELTA
STREAM_BATCH_CHARS=4
STREAM_BATCH_MS=80

# 平台预设审核模型（护栏用，与用户 LLM 配置无关，不花用户 token）。
# AUDIT_ENABLED=true 但 AUDIT_MODEL 为空 → 审核降级为仅正则快筛（不调 LLM）。
AUDIT_ENABLED=true
AUDIT_PROVIDER=openai_compat
AUDIT_MODEL=
AUDIT_APIKEY=
AUDIT_BASE_URL=
# 输出审核：两次审核最小间隔(ms) / 最小字符增量 / 滑窗上限(字符)
AUDIT_INTERVAL_MS=60000
AUDIT_MIN_CHARS_BETWEEN=80
AUDIT_MAX_BUFFER_CHARS=1500
# 审核读超时(秒，短，避免拖垮打字机)。审核输出固定 0/1 单字符，max_tokens 固定为 2。
AUDIT_REQUEST_TIMEOUT=20
# 正则前置快筛：命中即决，不调 LLM（拦 80% 典型越狱）
AUDIT_QUICK_FILTER=true
# 快筛黑名单文件路径：空=内置 backend/app/forge/blacklist.txt（按 mtime 热加载，
# 改文件即生效无需重启；docker 可挂载外部文件覆盖）
AUDIT_BLACKLIST_FILE=
# AC 敏感词词库（P1：block 即决；关则只跑 blacklist.txt）
# AUDIT_LEXICON_DIR 空=内置 backend/app/forge/lexicons/
AUDIT_LEXICON_ENABLED=true
AUDIT_LEXICON_DIR=
# 灰名单（suspect/politics）命中会强制走审核 LLM；AUDIT_MODEL 为空时灰名单 fail-open 放行

# 全局
ENV=development
# ADR-07：dev 调试路由显式开关（默认关；本地开发需要 /api/v1/dev/* 时设 true）
DEV_ROUTES_ENABLED=true
LOG_LEVEL=INFO
# 日志落盘：空=仓库根 logs/（backend.log / worker.log）；-=仅 stdout
LOG_DIR=
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
# 账号禁用时登录提示中的管理员联系邮箱（可在后台「全局设置」覆盖）
ADMIN_CONTACT_EMAIL=wxcurry@163.com

# Forge Runtime 旗标默认已在 app/core/config.py；仅覆盖时取消注释
# MEMORY_PREFERENCES_INFERRED=true
# MEMORY_PREFERENCES_MAX_ACTIVE=50
# MEMORY_SESSION_SUMMARY_LLM=true
# SKILLS_LLM_SELECTION=true
# SKILLS_QUALITY_LIFT_LLM=true
# EXACT_CACHE_ENABLED=true
# SEMANTIC_CACHE_SHADOW_ENABLED=true

# --- ADR-06 Semantic Cache（Pinecone）+ 偏好抽取 ---
# Exact Redis 仍优先；Semantic：<0.85 miss；[0.85,0.95) 轻量 LLM 确认；>=0.95 直接返回
# SEMANTIC_CACHE_DIRECT_HIT_ENABLED=true
# SEMANTIC_CACHE_SOFT_THRESHOLD=0.85
# SEMANTIC_CACHE_HARD_THRESHOLD=0.95

# Embedding：OpenAI-compat POST {base}/embeddings；无 APIKEY/BASE_URL → 语义命中空操作
# 本地免费默认：docker compose 的 embedding 服务（TEI + BAAI/bge-small-zh-v1.5，512 维）
# scripts/dev.sh 会一并启动；也可：docker compose up -d embedding
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_APIKEY=local
EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
# EMBEDDING_TIMEOUT_S=30


# Pinecone：需 API_KEY + HOST（控制台 Index Host）；缺一则仅 Exact + Redis shadow
PINECONE_ENABLED=true
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX=gameforge-semantic
PINECONE_NAMESPACE=default
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# ADR-14 Knowledge RAG（独立 Index gameforge-knowledge；禁止复用 PINECONE_HOST）
KNOWLEDGE_RAG_ENABLED=false
PINECONE_KNOWLEDGE_HOST=
PINECONE_KNOWLEDGE_NAMESPACE=global
PINECONE_KNOWLEDGE_INDEX=gameforge-knowledge
# Ops: create index dim=512 (bge-small-zh-v1.5) → probe → ingest → eval
#   uv run python -m scripts.probe_knowledge_pinecone --write-probe
#   uv run python -m scripts.ingest_knowledge --verify
#   uv run python -m scripts.eval_knowledge_rag
# KNOWLEDGE_RAG_INJECT_PLAN=true
# KNOWLEDGE_RAG_INJECT_REVISE=true
# KNOWLEDGE_RAG_INJECT_ART=false
# KNOWLEDGE_RAG_INJECT_CODE=false
# KNOWLEDGE_RETRIEVE_K=12
# KNOWLEDGE_RERANK_TOP_N=4
# KNOWLEDGE_SEMANTIC_RERANK_ENABLED=true
# KNOWLEDGE_TOKEN_BUDGET=800
# KNOWLEDGE_QUERY_MAX_TOKENS=480
# KNOWLEDGE_MIN_RELEVANCE_SCORE=0.35
# KNOWLEDGE_RETRIEVE_TIMEOUT_S=8.0
# KNOWLEDGE_EMBEDDING_EXPECTED_DIM=512
# Ops bootstrap: uv run python -m scripts.knowledge_bootstrap

# ADR-13 Native Engine（Godot-first；默认关）
NATIVE_ENGINE_ENABLED=false
# NATIVE_ENGINE_GODOT_VERSION=4.3
# NATIVE_ENGINE_GODOT_BIN=/usr/bin/godot4
# NATIVE_ENGINE_GODOT_DOCKER_IMAGE=gameforge-godot-builder:v1
# NATIVE_ENGINE_GODOT_BUILD_TIMEOUT_S=120
# NATIVE_ENGINE_GODOT_RUN_TIMEOUT_S=30

# 偏好自动抽取：与 AUDIT_* 同体系字段；仅轻量 chat，禁止规则正式路径
# PREFERENCE_EXTRACT_MODEL 为空 → 不自动写偏好（用户仍可走 /me/preferences API）
PREFERENCE_EXTRACT_ENABLED=true
PREFERENCE_EXTRACT_PROVIDER=openai_compat
PREFERENCE_EXTRACT_MODEL=
PREFERENCE_EXTRACT_APIKEY=
PREFERENCE_EXTRACT_BASE_URL=

# 语义软命中确认 LLM（空 model 时回退 PREFERENCE_EXTRACT_*）
SEMANTIC_CONFIRM_PROVIDER=openai_compat
SEMANTIC_CONFIRM_MODEL=
SEMANTIC_CONFIRM_APIKEY=
SEMANTIC_CONFIRM_BASE_URL=
